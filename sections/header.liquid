<!-- HEADER SECTION - Hidden on collection pages with sidebar -->
<nav id="navbar-section" class="navbar navbar-default navbar-static-top navbar-sticky main-header" role="navigation" style="display: none;">
  <div class="container">
  
    <div class="navbar-header">
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-responsive-collapse">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      
      {%- if section.settings.logo != blank -%}
        <a class="navbar-brand" href="/">
          <img src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name }}">
        </a>
      {%- else -%}
        <a class="navbar-brand" href="/">{{ shop.name }}</a>
      {%- endif -%}
    </div>

    <div id="navbar-spy" class="collapse navbar-collapse navbar-responsive-collapse">
      <ul class="nav navbar-nav pull-right">
        <li class="{% if template == 'index' %}active{% endif %}">
          <a href="/">홈</a>
        </li>
        <li class="{% if template contains 'page' and page.handle == 'about' %}active{% endif %}">
          <a href="/pages/about">회사소개</a>
        </li>
        <li class="{% if template contains 'collection' %}active{% endif %}">
          <a href="/collections/all">상품</a>
        </li>
        <li class="{% if template contains 'blog' %}active{% endif %}">
          <a href="/blogs/news">블로그</a>
        </li>
        <li class="{% if template contains 'page' and page.handle == 'team' %}active{% endif %}">
          <a href="/pages/team">판매팀</a>
        </li>
        <li class="{% if template contains 'page' and page.handle == 'contact' %}active{% endif %}">
          <a href="/pages/contact"><span>문의하기</span></a>
        </li>
        <li>
          <a href="/cart" class="cart-link">
            <i class="fa fa-shopping-cart"></i>
            <span class="cart-count">{{ cart.item_count }}</span>
          </a>
        </li>
      </ul>         
    </div>
  </div>
</nav>

<style>
  /* Show header only on non-collection pages */
  body:not(.template-collection) .main-header {
    display: block !important;
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "로고 이미지"
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "장바구니 수량 표시",
      "default": true
    }
  ]
}
{% endschema %}
