<!-- FEATURED PRODUCTS SECTION -->
<section class="featured-products">
  {%- if section.settings.heading != blank -%}
    <div class="row">
      <div class="col-md-12 text-center">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="lead">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  
  <div class="row">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection == empty -%}
      {%- assign collection = collections.all -%}
    {%- endif -%}
    
    {%- for product in collection.products limit: section.settings.products_to_show -%}
      <div class="col-lg-{{ 12 | divided_by: section.settings.products_per_row }} col-md-4 col-sm-6 col-xs-12">
        <div class="product-grid-item">
          {%- if product.available == false -%}
            <span class="product-badge sold-out">Sold Out</span>
          {%- elsif product.compare_at_price > product.price -%}
            <span class="product-badge sale">Sale</span>
          {%- elsif product.created_at > 'now' | date: '%s' | minus: 2592000 -%}
            <span class="product-badge new">New</span>
          {%- endif -%}
          
          <a href="{{ product.url }}" class="product-image-link">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title | escape }}">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          
          <div class="product-info">
            <h3 class="product-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <div class="product-price">
              {%- if product.compare_at_price > product.price -%}
                <span class="price-compare">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
              <span class="price-regular">{{ product.price | money }}</span>
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  
  {%- if section.settings.show_view_all -%}
    <div class="row">
      <div class="col-md-12 text-center" style="margin-top: 30px;">
        <a href="/collections/{{ section.settings.collection }}" class="btn btn-lg btn-default">
          전체 상품 보기
        </a>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "추천 상품",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "제목",
      "default": "추천 상품"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "부제목"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "컬렉션"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "표시할 상품 수",
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "한 줄에 표시할 상품 수",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "전체 보기 버튼 표시",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "추천 상품"
    }
  ]
}
{% endschema %}

<style>
.featured-products {
  padding: 60px 0;
  background-color: #f8f9fa;
}

.featured-products h2 {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 10px;
  color: #333;
}

.featured-products .lead {
  font-size: 18px;
  color: #666;
  margin-bottom: 40px;
}

.product-grid-item {
  background: white;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 30px;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  position: relative;
}

.product-grid-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

.product-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: #ff4444;
  color: white;
  padding: 5px 15px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  z-index: 2;
}

.product-badge.sold-out {
  background: #999;
}

.product-badge.sale {
  background: #ff4444;
}

.product-badge.new {
  background: #4CAF50;
}

.product-image-link {
  display: block;
  position: relative;
  overflow: hidden;
  padding-top: 100%;
}

.product-image-link img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.product-grid-item:hover .product-image-link img {
  transform: scale(1.1);
}

.product-info {
  padding: 20px;
}

.product-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 10px;
}

.product-title a {
  color: #333;
  text-decoration: none;
  transition: color 0.3s ease;
}

.product-title a:hover {
  color: #007bff;
}

.product-price {
  font-size: 20px;
  font-weight: 700;
  color: #333;
}

.price-compare {
  text-decoration: line-through;
  color: #999;
  font-size: 16px;
  margin-right: 10px;
}

.price-regular {
  color: #ff4444;
}
</style>
