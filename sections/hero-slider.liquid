<!-- HERO/SLIDER SECTION -->
<section id="hero-section" class="hero-section">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'slide' -%}
        <div class="hero-slide {{ block.settings.text_alignment }}">
          {%- if block.settings.image != blank -%}
            <div class="hero-image" style="background-image: url('{{ block.settings.image | img_url: '1920x' }}');">
          {%- else -%}
            <div class="hero-image" style="background-color: {{ block.settings.bg_color }};">
          {%- endif -%}
            <div class="container">
              <div class="hero-content">
                {%- if block.settings.heading != blank -%}
                  <h1>{{ block.settings.heading }}</h1>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="lead">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}" class="btn btn-primary btn-lg">
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "히어로/슬라이더",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "slide",
      "name": "슬라이드",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "배경 이미지"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "배경 색상 (이미지가 없을 경우)",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "제목",
          "default": "프리미엄 오토 모터스"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "부제목",
          "default": "최고의 차량을 만나보세요"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "버튼 텍스트",
          "default": "상품 보기"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "버튼 링크"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "텍스트 정렬",
          "options": [
            {
              "value": "left",
              "label": "왼쪽"
            },
            {
              "value": "center",
              "label": "가운데"
            },
            {
              "value": "right",
              "label": "오른쪽"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "히어로/슬라이더",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.hero-section {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.hero-slide {
  position: relative;
  width: 100%;
}

.hero-image {
  min-height: 500px;
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.hero-image::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: white;
  max-width: 800px;
  margin: 0 auto;
}

.hero-content h1 {
  font-size: 56px;
  font-weight: 700;
  margin-bottom: 20px;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
  animation: fadeInUp 0.8s ease;
}

.hero-content .lead {
  font-size: 24px;
  margin-bottom: 30px;
  text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
  animation: fadeInUp 1s ease;
}

.hero-content .btn {
  padding: 15px 40px;
  font-size: 18px;
  font-weight: 600;
  text-transform: uppercase;
  border-radius: 50px;
  transition: all 0.3s ease;
  animation: fadeInUp 1.2s ease;
}

.hero-content .btn:hover {
  transform: scale(1.05);
  box-shadow: 0 5px 20px rgba(0,0,0,0.3);
}

.hero-slide.left .hero-content {
  text-align: left;
}

.hero-slide.right .hero-content {
  text-align: right;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 768px) {
  .hero-image {
    min-height: 400px;
  }
  
  .hero-content h1 {
    font-size: 36px;
  }
  
  .hero-content .lead {
    font-size: 18px;
  }
}
</style>
