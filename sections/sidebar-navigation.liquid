<!-- SIDEBAR NAVIGATION -->
<aside class="sidebar-navigation">
  {%- if section.settings.logo != blank -%}
    <div class="sidebar-logo">
      <a href="/">
        <img src="{{ section.settings.logo | img_url: '150x' }}" alt="{{ shop.name }}">
      </a>
    </div>
  {%- else -%}
    <div class="sidebar-logo">
      <a href="/">
        <h2>LOGO</h2>
      </a>
    </div>
  {%- endif -%}

  <nav class="sidebar-menu">
    <ul>
      {%- for link in linklists[section.settings.main_menu].links -%}
        <li class="{% if link.active %}active{% endif %}">
          <a href="{{ link.url }}">{{ link.title }}</a>
          
          {%- if link.links != blank -%}
            <ul class="submenu">
              {%- for child_link in link.links -%}
                <li class="{% if child_link.active %}active{% endif %}">
                  <a href="{{ child_link.url }}">
                    <i class="fa fa-caret-right"></i> {{ child_link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  {%- if section.settings.show_bottom_links -%}
    <div class="sidebar-bottom">
      <ul>
        <li><a href="/pages/contact">Contact</a></li>
        <li><a href="/blogs/news">Newsletter</a></li>
        <li><a href="/account">Subscribe</a></li>
      </ul>
    </div>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "사이드바 네비게이션",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "로고 이미지"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "메인 메뉴",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_links",
      "label": "하단 링크 표시",
      "default": true
    }
  ]
}
{% endschema %}

<style>
.sidebar-navigation {
  padding: 0;
  background: #f5f5f5;
  height: 100%;
}

.sidebar-logo {
  padding: 30px 20px;
  background: #fff;
  border-bottom: 1px solid #e0e0e0;
  text-align: center;
}

.sidebar-logo h2 {
  margin: 0;
  font-size: 24px;
  font-weight: 700;
  color: #000;
  letter-spacing: 2px;
}

.sidebar-logo a {
  color: #000;
  text-decoration: none;
}

.sidebar-menu {
  padding: 20px 0;
}

.sidebar-menu ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sidebar-menu > ul > li {
  border-bottom: 1px solid #e0e0e0;
}

.sidebar-menu > ul > li > a {
  display: block;
  padding: 15px 25px;
  color: #333;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.3s ease;
  background: #f5f5f5;
}

.sidebar-menu > ul > li > a:hover,
.sidebar-menu > ul > li.active > a {
  background: #fff;
  color: #000;
  padding-left: 30px;
}

.submenu {
  background: #fff;
  padding: 10px 0;
}

.submenu li a {
  display: block;
  padding: 10px 25px 10px 40px;
  color: #666;
  text-decoration: none;
  font-size: 13px;
  transition: all 0.3s ease;
}

.submenu li a:hover {
  color: #000;
  padding-left: 45px;
}

.submenu li a i {
  margin-right: 8px;
  font-size: 10px;
}

.sidebar-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px;
  background: #fff;
  border-top: 1px solid #e0e0e0;
}

.sidebar-bottom ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sidebar-bottom li {
  margin-bottom: 10px;
}

.sidebar-bottom a {
  color: #666;
  text-decoration: none;
  font-size: 13px;
  transition: color 0.3s ease;
}

.sidebar-bottom a:hover {
  color: #000;
}
</style>
