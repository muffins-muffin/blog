<!-- INDEX TEMPLATE WITH SIDEBAR -->
<div class="shop-layout-wrapper">
  <!-- Sidebar Navigation -->
  <div class="shop-sidebar">
    {% section 'sidebar-navigation' %}
  </div>
  
  <!-- Main Content Area -->
  <div class="shop-main-content">
    <!-- Top Bar with Cart -->
    <div class="shop-top-bar">
      <div class="shop-top-bar-inner">
        <div class="shop-breadcrumb">
          <a href="/">Home</a> / <span>Jeans</span>
        </div>
        <div class="shop-cart-icon">
          <a href="/cart">
            <i class="fa fa-shopping-cart"></i> Cart
            <span class="cart-badge">{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
    </div>
    
    <!-- Hero Banner -->
    <div class="shop-hero-section">
      {% section 'collection-hero' %}
    </div>
    
    <!-- Products Grid -->
    <div class="shop-products-section">
      {% section 'featured-products' %}
    </div>
  </div>
</div>

<style>
  body {
    margin: 0;
    padding: 0;
    background: #fff;
  }
  
  .shop-layout-wrapper {
    display: flex;
    min-height: 100vh;
  }
  
  .shop-sidebar {
    width: 220px;
    background: #f5f5f5;
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 100;
    border-right: 1px solid #e0e0e0;
  }
  
  .shop-main-content {
    margin-left: 220px;
    flex: 1;
    background: #fff;
  }
  
  .shop-top-bar {
    background: #fff;
    border-bottom: 1px solid #e0e0e0;
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 90;
  }
  
  .shop-top-bar-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .shop-breadcrumb {
    font-size: 14px;
    color: #666;
  }
  
  .shop-breadcrumb a {
    color: #333;
    text-decoration: none;
  }
  
  .shop-breadcrumb a:hover {
    color: #000;
  }
  
  .shop-cart-icon a {
    color: #333;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  
  .cart-badge {
    background: #000;
    color: #fff;
    border-radius: 50%;
    padding: 2px 7px;
    font-size: 11px;
    margin-left: 5px;
  }
  
  .shop-hero-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
  }
  
  .shop-products-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 30px;
  }
  
  @media (max-width: 992px) {
    .shop-sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }
    
    .shop-sidebar.active {
      transform: translateX(0);
    }
    
    .shop-main-content {
      margin-left: 0;
    }
  }
    .index-template-with-sidebar .main-content {
      margin-left: 0;
    }
  }
</style>
